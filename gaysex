function Library:CreateIndicator(id, text, color, layoutOrder, icon)
local state = false
local currentColor = color or Colors.Accent1
local currentText = text
local currentIcon = icon

return {
    Toggle = function(self, isEnabled)
        state = isEnabled
        if state then
            Indicators.Set(id, currentText, currentColor, layoutOrder, currentIcon)
        else
            Indicators.Remove(id)
        end
    end,
    SetText = function(self, newText)
        currentText = newText
        if state then
            Indicators.Set(id, currentText, currentColor, layoutOrder, currentIcon)
        end
    end,
    SetColor = function(self, newColor)
        currentColor = newColor
        if state then
            Indicators.Set(id, currentText, currentColor, layoutOrder, currentIcon)
        end
    end,
    SetIcon = function(self, newIcon)
        currentIcon = newIcon
        if state then
            Indicators.Set(id, currentText, currentColor, layoutOrder, currentIcon)
        end
    end,
    GetState = function(self)
        return state
    end
}


end

local function RGBtoHSV(color)
local h, s, v = color:ToHSV()
return h * 360, s, v
end

local function Get5ColorGradient(r, g, b, upsideDown)
local intensity = 8
local c1 = Color3.fromRGB(math.clamp(r - intensity, 0, 255), math.clamp(g - intensity, 0, 255), math.clamp(b - intensity, 0, 255))
local c2 = Color3.fromRGB(r, g, b)
local c3 = Color3.fromRGB(math.clamp(r + intensity, 0, 255), math.clamp(g + intensity, 0, 255), math.clamp(b + intensity, 0, 255))

if upsideDown then
    return ColorSequence.new{
        ColorSequenceKeypoint.new(0, c3),
        ColorSequenceKeypoint.new(0.25, c2),
        ColorSequenceKeypoint.new(0.5, c1),
        ColorSequenceKeypoint.new(0.75, c2),
        ColorSequenceKeypoint.new(1, c3)
    }
else
    return ColorSequence.new{
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(0.25, c2),
        ColorSequenceKeypoint.new(0.5, c3),
        ColorSequenceKeypoint.new(0.75, c2),
        ColorSequenceKeypoint.new(1, c1)
    }
end


end

local function MakeDraggable(topbarobject, object)
local Dragging, DragInput, DragStart, StartPosition = nil, nil, nil, nil
topbarobject.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
Dragging = true
DragStart = input.Position
StartPosition = object.Position
input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then Dragging = false end
end)
end
end)
topbarobject.InputChanged:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then DragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
if input == DragInput and Dragging then
local Delta = input.Position - DragStart
object.Position = UDim2.new(StartPosition.X.Scale, StartPosition.X.Offset + Delta.X, StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y)
end
end)
end

