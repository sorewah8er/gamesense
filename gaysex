    local Args = {...}
    local Method = getnamecallmethod()

    if ScriptState.Aimbot.Enabled and CurrentHitPart and not checkcaller() then
        local Chance = math.random(1, 100) <= ScriptState.Aimbot.Hitchance
        if Chance then
            local hitPos = GetTargetPosition(CurrentHitPart)
            if Method == "Raycast" and (self == Workspace or self == workspace) then
                if typeof(Args[1]) == "Vector3" and typeof(Args[2]) == "Vector3" then
                    Args[2] = (hitPos - Args[1]).Unit * 10000
                    return OldNameCall(self, unpack(Args))
                end
            end
            if (Method == "FindPartOnRay" or Method == "FindPartOnRayWithWhitelist" or Method == "FindPartOnRayWithIgnoreList") and (self == Workspace or self == workspace) then
                if typeof(Args[1]) == "Ray" then
                    Args[1] = Ray.new(Args[1].Origin, (hitPos - Args[1].Origin).Unit * 10000)
                    return OldNameCall(self, unpack(Args))
                end
            end
            if (self == Mouse or tostring(self) == "Mouse") then
                if Method == "Hit" then return CFrame.new(hitPos)
                elseif Method == "Target" then return CurrentHitPart end
            end
            if Method == "FireServer" and ScriptState.Aimbot.RemoteDetection then 
                for i, arg in pairs(Args) do
                    if typeof(arg) == "Vector3" then
                        if (arg - Camera.CFrame.Position).Magnitude > 5 then Args[i] = hitPos end
                    elseif typeof(arg) == "CFrame" then
                        if (arg.Position - Camera.CFrame.Position).Magnitude > 5 then Args[i] = CFrame.new(hitPos) end
                    end
                end
                return OldNameCall(self, unpack(Args))
            end
        end
    end
    return OldNameCall(self, ...)
end))

