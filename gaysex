local CurrentTarget = nil
local CurrentHitPart = nil

local PriorityParts = {"Head", "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso"}
local MaxRange = 9999


local function IsAlive(plr)
    if plr and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
        return true
    end
    return false
end

local function GetTargetPosition(part)
    return part and part.Position or Vector3.new(0,0,0)
end

local function CheckVisibility(origin, targetPart)
    if not ScriptState.Aimbot.WallCheck then return true end
    local direction = targetPart.Position - origin
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    local result = Workspace:Raycast(origin, direction, rayParams)
    if result and result.Instance:IsDescendantOf(targetPart.Parent) then return true end
    if result then return false end
    return true
end

local function GetClosestTarget()
    local closestPlr = nil
    local shortestDistance = MaxRange
    local bestPart = nil
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) and IsAlive(LocalPlayer) then
            local isTeammate = (ScriptState.Aimbot.TeamCheck and plr.Team == LocalPlayer.Team)
            local hasForceField = plr.Character and plr.Character:FindFirstChildOfClass("ForceField")
            if not isTeammate and not hasForceField then
                local char = plr.Character
                local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not myRoot then return nil, nil end
                local targetRoot = char:FindFirstChild("HumanoidRootPart")
                if targetRoot then
                    local dist = (targetRoot.Position - myRoot.Position).Magnitude
                    if dist < shortestDistance then
                        for _, partName in pairs(PriorityParts) do
                            local part = char:FindFirstChild(partName)
                            if part and CheckVisibility(Camera.CFrame.Position, part) then
                                closestPlr = plr
                                shortestDistance = dist
                                bestPart = part
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPlr, bestPart
end


