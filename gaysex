    TabBtn.MouseButton1Click:Connect(function()
        local newIndex = table.find(Window.Tabs, Tab)
        if Window.CurrentTabIndex == newIndex then return end

        local direction = Window.CurrentTabIndex < newIndex and 1 or -1
        local animOffset = 40 * direction

        for i, otherTab in pairs(Window.Tabs) do
            if otherTab ~= Tab and otherTab.Canvas.Visible then
                local oldCanvas = otherTab.Canvas
                TweenService:Create(oldCanvas, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    GroupTransparency = 1,
                    Position = UDim2.new(0, 20, 0, 20 - animOffset)
                }):Play()
                
                task.delay(0.25, function() 
                    if Window.CurrentTabIndex ~= i then 
                        oldCanvas.Visible = false 
                    end 
                end)

                otherTab.Border.Visible = false
                TweenService:Create(otherTab.Icon, TweenInfo.new(0.2), {ImageColor3 = Color3.fromRGB(90, 90, 90)}):Play()
            end
        end

        TabCanvas.Position = UDim2.new(0, 20, 0, 20 + animOffset)
        TabCanvas.GroupTransparency = 1 
        TabCanvas.Visible = true
        
        TweenService:Create(TabCanvas, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            GroupTransparency = 0, 
            Position = UDim2.new(0, 20, 0, 20)
        }):Play()

        TabBorder.Visible = true
        TweenService:Create(TabIcon, TweenInfo.new(0.2), {ImageColor3 = Color3.fromRGB(167, 167, 167)}):Play()

        Window.CurrentTabIndex = newIndex
        Window.CurrentTab = Tab
    end)

    Tab.Canvas = TabCanvas
    Tab.Page = TabPage
    Tab.Icon = TabIcon
    Tab.Border = TabBorder
    table.insert(Window.Tabs, Tab)

    if #Window.Tabs == 1 then
        TabCanvas.Visible = true
        TabCanvas.GroupTransparency = 0 
        TabBorder.Visible = true
        TabIcon.ImageColor3 = Color3.fromRGB(167, 167, 167)
        Window.CurrentTabIndex = 1
        Window.CurrentTab = Tab
