    local function updateSV(position) local abs, size = svCanvas.AbsolutePosition, svCanvas.AbsoluteSize; sat = math.clamp((position.X - abs.X) / size.X, 0, 1); val = 1 - math.clamp((position.Y - abs.Y) / size.Y, 0, 1); color = Color3.fromHSV(hue, sat, val); paint(); if params.Callback then safeCallback(params.Callback, color, alpha) end end
    local function updateHue(position) local abs, size = hueCanvas.AbsolutePosition, hueCanvas.AbsoluteSize; hue = math.clamp((position.Y - abs.Y) / size.Y, 0, 1); color = Color3.fromHSV(hue, sat, val); paint(); if params.Callback then safeCallback(params.Callback, color, alpha) end end
