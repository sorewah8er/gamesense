local function parentGui()
local ok, result = pcall(function() return gethui and gethui() end)
if ok and result then return result end
local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
return playerGui or CoreGui
end

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local function tryDecode(decoder, data)
if type(decoder) ~= "function" then return nil end
local ok, result = pcall(decoder, data)
if ok and type(result) == "string" then return result end
return nil
end

local function decodeBase64(data)
return tryDecode(crypt and crypt.base64 and crypt.base64.decode, data)
or tryDecode(syn and syn.crypt and syn.crypt.base64 and syn.crypt.base64.decode, data)
or tryDecode(base64 and base64.decode, data)
or tryDecode(base64_decode, data)
or tryDecode(crypt and crypt.base64_decode, data)
end

local function ensureFolder(pathName)
if not makefolder then return end
local exists = false
if isfolder then
local ok, result = pcall(isfolder, pathName)
exists = ok and result
end
if not exists then pcall(makefolder, pathName) end
end

local function loadBitmapFontAsset(name, data)
if not writefile or not getcustomasset or not Font or not Font.new then return nil end
local decoded = decodeBase64(data)
if not decoded then return nil end

local rootFolder = "supremacy"
local fontFolder = rootFolder .. "/fonts"
ensureFolder(rootFolder)
ensureFolder(fontFolder)

local fontPath = fontFolder .. "/" .. name .. ".ttf"
local fontMetaPath = fontFolder .. "/" .. name .. ".font"
local okWrite = pcall(function()
    writefile(fontPath, decoded)
    writefile(fontMetaPath, HttpService:JSONEncode({
        name = name,
        faces = {{ name = "Regular", weight = 400, style = "normal", assetId = getcustomasset(fontPath) }}
    }))
end)
if not okWrite then return nil end
local okAsset, asset = pcall(getcustomasset, fontMetaPath)
if not okAsset then return nil end
local okFont, fontFace = pcall(function()
    return Font.new(asset, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
end)
return okFont and fontFace or nil


end

local function loadRemoteFontAsset(name, url)
if not writefile or not getcustomasset or not Font or not Font.new then return nil end
local body
local okHttp, httpResult = pcall(function() if game.HttpGet then return game:HttpGet(url) end end)
if okHttp and type(httpResult) == "string" and #httpResult > 4 then
body = httpResult
else
local requester = request or http_request or (syn and syn.request)
if type(requester) == "function" then
local okRequest, response = pcall(requester, { Url = url, Method = "GET" })
if okRequest and response and type(response.Body) == "string" then body = response.Body end
end
end

if not body then return nil end

local rootFolder = "supremacy"
local fontFolder = rootFolder .. "/fonts"
ensureFolder(rootFolder)
ensureFolder(fontFolder)

local fontPath = fontFolder .. "/" .. name .. ".ttf"
local fontMetaPath = fontFolder .. "/" .. name .. ".font"
pcall(function()
    writefile(fontPath, body)
    writefile(fontMetaPath, HttpService:JSONEncode({
        name = name,
        faces = {{ name = "Regular", weight = 400, style = "normal", assetId = getcustomasset(fontPath) }}
    }))
end)
local okAsset, asset = pcall(getcustomasset, fontMetaPath)
if not okAsset then return nil end
local okFont, fontFace = pcall(function() return Font.new(asset, Enum.FontWeight.Regular, Enum.FontStyle.Normal) end)
return okFont and fontFace or nil


end

