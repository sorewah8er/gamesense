function SectionMethods:MultiDropdown(params)
    params = params or {}
    local values = {}
    for _, value in ipairs(params.Default or {}) do values[value] = true end
    local displayParams = {}
    for k, v in pairs(params) do displayParams[k] = v end
    displayParams.Default = "none"; displayParams.Callback = nil
    local control = self:Dropdown(displayParams)
    local oldRefresh = control.RefreshOptions
    control.KeepOpenOnSelect = true
    control.IsOptionActive = function(option) return values[option] == true end

    local function compactList(items, limit)
        local textValue = ""
        for index, item in ipairs(items) do
            local nextValue = index == 1 and tostring(item) or (textValue .. ", " .. tostring(item))
            if #nextValue > limit then return textValue == "" and "..." or (textValue .. ", ...") end
            textValue = nextValue
        end
        return textValue
    end
    local function display()
        local chosen = {}
        for _, option in ipairs(params.Options or {}) do if values[option] then chosen[#chosen + 1] = option end end
        return #chosen > 0 and compactList(chosen, 22) or "none"
    end
    local function setValue(option, call)
        if type(option) == "table" then
            values = option
        else
            values[option] = not values[option]
        end
        control.ValueLabel.Text = display(); control.RefreshOptions()
        if call ~= false then safeCallback(params.Callback, values) end
    end
    control.Set = setValue; control.Get = function() return values end
    oldRefresh(params.Options or {}); control.ValueLabel.Text = display()
    flagObject(params.Flag, control)
    return control
end


