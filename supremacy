    local hueMarker = new("Frame", { Parent = hueCanvas, Size = UDim2.new(1, 2, 0, 2), Position = UDim2.new(0, -1, 0, 0), BackgroundColor3 = theme.White, BorderSizePixel = 1, BorderColor3 = theme.Border, ZIndex = hueCanvas.ZIndex + 5 })
