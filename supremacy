function Library:Notify(textStr, duration)
    duration = duration or self.NotificationSettings.Duration
    local targetTrans = self.NotificationSettings.Transparency
    
    local notifOuter = new("Frame", { Parent = self.NotifLayout, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 })
    local notif = new("Frame", { Parent = notifOuter, Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = theme.Background })
    
    local borderColors = { rgb(60, 60, 60), rgb(40, 40, 40), rgb(40, 40, 40), rgb(40, 40, 40), rgb(60, 60, 60), rgb(31, 31, 31) }
    local strokes = {}
    local totalThickness = 0
    for _, color in ipairs(borderColors) do
        local borderFrame = new("Frame", { Parent = notif, Size = UDim2.new(1, (totalThickness - 1) * 2 + 2, 1, (totalThickness - 1) * 2 + 2), Position = UDim2.new(0, -(totalThickness - 1) - 1, 0, -(totalThickness - 1) - 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = notif.ZIndex + 1 })
        local stroke = new("UIStroke", { Parent = borderFrame, LineJoinMode = Enum.LineJoinMode.Miter, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = color, Thickness = 1 })
        strokes[#strokes+1] = stroke; totalThickness = totalThickness + 1
    end

    local txt = text(notif, textStr, UDim2.new(0, 8, 0, 0), UDim2.new(1, -16, 1, 0), theme.Text, notif.ZIndex + 2)
    local accentLine = new("Frame", { Parent = notif, Size = UDim2.new(0, 2, 1, 0), Position = UDim2.new(0, 0, 0, 0), BackgroundColor3 = theme.Accent, BorderSizePixel = 0, ZIndex = notif.ZIndex + 2 })

    notif.BackgroundTransparency = 1; txt.TextTransparency = 1; accentLine.BackgroundTransparency = 1
    for _, stroke in ipairs(strokes) do stroke.Transparency = 1 end

    local function tweenTrans(trans)
        TweenService:Create(notif, TweenInfo.new(0.3), {BackgroundTransparency = trans}):Play()
        TweenService:Create(txt, TweenInfo.new(0.3), {TextTransparency = trans}):Play()
        TweenService:Create(accentLine, TweenInfo.new(0.3), {BackgroundTransparency = trans}):Play()
        for _, stroke in ipairs(strokes) do TweenService:Create(stroke, TweenInfo.new(0.3), {Transparency = trans}):Play() end
    end

    tweenTrans(targetTrans)
    task.delay(duration, function()
        tweenTrans(1); task.wait(0.3); notifOuter:Destroy()
    end)
end

function Library:GetConfigs()
    local list = {}
    ensureFolder("supremacy_reborn/configs")
    if isfolder and listfiles and isfolder("supremacy_reborn/configs") then
        local s, files = pcall(function() return listfiles("supremacy_reborn/configs") end)
        if s and files then
            for _, file in ipairs(files) do
                local name = file:match("([^/\\]+)%.json$")
                if name then table.insert(list, name) end
            end
        end
    end
    if #list == 0 then table.insert(list, "default") end
    return list
end

function Library:RefreshConfigs()
    if self.Flags["config_list"] and self.Flags["config_list"].RefreshOptions then
        self.Flags["config_list"].RefreshOptions(self:GetConfigs())
    end
end

function Library:SaveConfig(name)
    if not name or name == "" then self:Notify("Invalid config name", 3) return end
    ensureFolder("supremacy_reborn/configs")
    local data = { Flags = {}, Positions = {} }
    for flag, control in pairs(self.Flags) do
        if control.Get and not flag:match("^config_") then
            local val = control.Get()
            if typeof(val) == "Color3" then val = {val.R, val.G, val.B} end
            if typeof(val) == "EnumItem" then val = val.Name end
            data.Flags[flag] = val
        end
    end

    if self.Windows[1] then
        local pos = self.Windows[1].Root.Position
        data.Positions.Main = {pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset}
    end
    if self.WatermarkFrame then
        local pos = self.WatermarkFrame.Position
        data.Positions.Watermark = {pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset}
    end
    if self.KeybindFrame then
        local pos = self.KeybindFrame.Position
        data.Positions.Keybinds = {pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset}
    end

    local s, err = pcall(function()
        writefile("supremacy_reborn/configs/" .. name .. ".json", HttpService:JSONEncode(data))
    end)
    if s then self:Notify("Saved config: " .. name, 3) else self:Notify("Save Error!", 3) end
    self:RefreshConfigs()
end

function Library:LoadConfig(name)
    if not name or name == "" then return end
    local path = "supremacy_reborn/configs/" .. name .. ".json"
    local success, fileData = pcall(function() return readfile(path) end)
    if not success then self:Notify("Config not found", 3) return end
    
    local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(fileData) end)
    if not decodeSuccess then self:Notify("Failed to parse config", 3) return end

    if data.Flags then
        for flag, val in pairs(data.Flags) do
            if self.Flags[flag] and self.Flags[flag].Set then
                local currentVal = self.Flags[flag].Get()
                if typeof(currentVal) == "Color3" and type(val) == "table" then 
                    val = Color3.new(unpack(val))
                    pcall(function() self.Flags[flag].Set(val, 1, true) end)
                elseif typeof(currentVal) == "EnumItem" and type(val) == "string" then 
                    pcall(function() val = Enum.KeyCode[val] end)
                    pcall(function() self.Flags[flag].Set(val, true) end)
                else
                    pcall(function() self.Flags[flag].Set(val, true) end)
                end
            end
        end
    end
    if data.Positions then
        if data.Positions.Main and self.Windows[1] then self.Windows[1].Root.Position = UDim2.new(unpack(data.Positions.Main)) end
        if data.Positions.Watermark and self.WatermarkFrame then self.WatermarkFrame.Position = UDim2.new(unpack(data.Positions.Watermark)) end
        if data.Positions.Keybinds and self.KeybindFrame then self.KeybindFrame.Position = UDim2.new(unpack(data.Positions.Keybinds)) end
    end
    self:Notify("Loaded config: " .. name, 3)
end

function Library:CreateWatermark(textValue)
    local wmGui = Instance.new("ScreenGui", self.Parent)
    wmGui.Name = "Supremacy_Watermark"
    wmGui.IgnoreGuiInset = true

    local wmFrame = new("Frame", { 
        Parent = wmGui, Size = UDim2.new(0, 0, 0, 18), Position = UDim2.new(1, -15, 0, 15), 
        AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = theme.Background, BorderSizePixel = 0
    })
    self.WatermarkFrame = wmFrame
    registerTransparency(wmFrame, false); applySupremacyBorders(wmFrame) 
    MakeDraggable(wmFrame, wmFrame)

    local wmText = text(wmFrame, textValue, UDim2.new(0, 6, 0, 0), UDim2.new(1, -12, 1, 0), theme.Text)
    wmText.TextStrokeTransparency = 0; wmText.TextStrokeColor3 = Color3.new(0,0,0)
    
    RunService.RenderStepped:Connect(function()
        if wmText.TextBounds.X > 0 then wmFrame.Size = UDim2.new(0, wmText.TextBounds.X + 16, 0, 18) end
    end)
    return { SetText = function(newText) wmText.Text = newText end, SetVisible = function(vis) wmGui.Enabled = vis end, Label = wmText }
end

function Library:UpdateKeybinds()
    if not self.KeybindContainer then return end
    for _, child in ipairs(self.KeybindContainer:GetChildren()) do if child:IsA("TextLabel") then child:Destroy() end end
    local count = 0
    for flagName, isActive in pairs(self.ActiveKeybinds) do
        if isActive then
            count = count + 1
            local item = text(self.KeybindContainer, flagName, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 14), theme.White)
            item.TextSize = 12; item.TextStrokeTransparency = 0; item.TextStrokeColor3 = Color3.new(0,0,0)
        end
    end
    self.KeybindFrame.Size = UDim2.new(0, 180, 0, 22 + (count * 16))
end

function Library:CreateKeybindList()
    local kbGui = Instance.new("ScreenGui", self.Parent)
    kbGui.Name = "Supremacy_KeybindList"
    kbGui.IgnoreGuiInset = true

    local kbFrame = new("Frame", { 
        Parent = kbGui, Size = UDim2.new(0, 180, 0, 20), Position = UDim2.new(0, 15, 0.5, 0), 
        BackgroundColor3 = theme.Background, ClipsDescendants = false
    })
    self.KeybindFrame = kbFrame
    registerTransparency(kbFrame, false); applySupremacyBorders(kbFrame) 
    MakeDraggable(kbFrame, kbFrame)

    local kbTitle = text(kbFrame, "keybinds", UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 18), theme.Text)
    kbTitle.TextXAlignment = Enum.TextXAlignment.Center; kbTitle.TextStrokeTransparency = 0; kbTitle.TextStrokeColor3 = Color3.new(0,0,0)
    local container = new("Frame", { Parent = kbFrame, Position = UDim2.new(0, 6, 0, 18), Size = UDim2.new(1, -12, 1, -22), BackgroundTransparency = 1 })
    local layout = addList(container, 2)
    self.KeybindContainer = container

    self:UpdateKeybinds()
    return { SetVisible = function(vis) kbGui.Enabled = vis end }
end

function Library:SetFontMode(mode) setMenuFontMode(mode) end
function Library:SetFontSize(size) setMenuFontSize(size) end
function Library:RegisterMenuText(inst, baseFont) registerMenuText(inst, baseFont) end

return Library


