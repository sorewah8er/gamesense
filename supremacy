local SupremacyUIFontEnum = Enum.Font.Code
local SupremacyFontMode = "default"
local SupremacyFontRegistry = {}

local function loadLibFont(stem, url)
if not writefile or not getcustomasset or not Font or not Font.new then return nil end
local ok, body = pcall(game.HttpGet, game, url)
if not ok or type(body) ~= "string" or #body < 4 then return nil end
local fontPath = "supremacy/fonts/" .. stem .. ".ttf"
local fontMetaPath = "supremacy/fonts/" .. stem .. ".font"
ensureFolder("supremacy")
ensureFolder("supremacy")
pcall(function()
writefile(fontPath, body)
writefile(fontMetaPath, HttpService:JSONEncode({
name = stem,
faces = {{ name = "Regular", weight = 400, style = "normal", assetId = getcustomasset(fontPath) }}
}))
end)
local okAsset, asset = pcall(getcustomasset, fontMetaPath)
if not okAsset then return nil end
local okFont, face = pcall(Font.new, asset, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
return okFont and face or nil
end

local _BASE_FONT_URL = "https://github.com/i77lhm/storage/raw/refs/heads/main/fonts/"
local SupremacyFontFaces = {
["default"]       = SupremacyDefaultUIFontFace,
["proggyclean"]   = loadLibFont("proggyclean",   _BASE_FONT_URL .. "ProggyClean.ttf"),
["tahoma"]        = loadLibFont("tahoma",        _BASE_FONT_URL .. "fs-tahoma-8px.ttf"),
["smallestpixel"] = loadLibFont("smallestpixel", _BASE_FONT_URL .. "smallest_pixel-7.ttf"),
["proggytiny"]    = loadLibFont("proggytiny",    _BASE_FONT_URL .. "ProggyTiny.ttf"),
["tahoma bold"]   = loadLibFont("tahomabold",    _BASE_FONT_URL .. "tahoma_bold.ttf"),
}

local _VALID_FONT_OPTION = {
["default"] = true, ["proggyclean"] = true, ["tahoma"] = true,
["smallestpixel"] = true, ["proggytiny"] = true,
["tahoma bold"] = true,
}
local SupremacyFontSize = 12

local function applyMenuFont(inst, baseFont)
local targetFace = SupremacyFontFaces[SupremacyFontMode] or SupremacyDefaultUIFontFace
if targetFace then
local ok = pcall(function() inst.FontFace = targetFace end)
if ok then
inst.TextSize = SupremacyFontSize
return
end
end
inst.Font = baseFont or SupremacyUIFontEnum
inst.TextSize = SupremacyFontSize
end

local function registerMenuText(inst, baseFont)
SupremacyFontRegistry[#SupremacyFontRegistry + 1] = { Instance = inst, BaseFont = baseFont or SupremacyUIFontEnum }
applyMenuFont(inst, baseFont)
end

local function setMenuFontSize(size)
SupremacyFontSize = math.clamp(math.floor(size + 0.5), 1, 18)
for index = #SupremacyFontRegistry, 1, -1 do
local entry = SupremacyFontRegistry[index]
if entry.Instance and entry.Instance.Parent then
entry.Instance.TextSize = SupremacyFontSize
else
table.remove(SupremacyFontRegistry, index)
end
end
end

local function setMenuFontMode(mode)
SupremacyFontMode = _VALID_FONT_OPTION[mode] and mode or "default"
for index = #SupremacyFontRegistry, 1, -1 do
local entry = SupremacyFontRegistry[index]
if entry.Instance and entry.Instance.Parent then
applyMenuFont(entry.Instance, entry.BaseFont)
else
table.remove(SupremacyFontRegistry, index)
end
end
end

local function new(className, props)
local inst = Instance.new(className)
for key, value in pairs(props or {}) do inst[key] = value end

if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
    if (props or {}).TextSize == nil then inst.TextSize = 12 end
    registerMenuText(inst, (props or {}).Font or SupremacyUIFontEnum)
    
    if not inst:IsA("TextBox") and (props or {}).TextStrokeTransparency == nil then
        inst.TextStrokeColor3 = Color3.new(0, 0, 0)
        inst.TextStrokeTransparency = 0.65
    end
end
return inst


end

local function addStroke(parent, color, thickness, transparency)
return new("UIStroke", {
Parent = parent, Color = color, Thickness = thickness or 1,
Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border
})
end

local function addList(parent, padding)
return new("UIListLayout", {
Parent = parent, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, padding or 6)
})
end

local function bindAutoHeight(frame, layout, extra)
local function update() frame.Size = UDim2.new(frame.Size.X.Scale, frame.Size.X.Offset, 0, layout.AbsoluteContentSize.Y + (extra or 0)) end
layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
task.defer(update)
end

local function text(parent, value, pos, size, color, z)
return new("TextLabel", {
Parent = parent, Position = pos or UDim2.new(), Size = size or UDim2.new(1, 0, 0, 14),
BackgroundTransparency = 1, BorderSizePixel = 0, Text = value or "", TextColor3 = color,
TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
TextSize = 12, Font = Enum.Font.Code, ZIndex = z or parent.ZIndex + 1
})
end

local function buttonOverlay(parent, z)
return new("TextButton", {
Parent = parent, Position = UDim2.new(), Size = UDim2.new(1, 0, 1, 0),
BackgroundTransparency = 1, BorderSizePixel = 0, Text = "",
AutoButtonColor = false, ZIndex = z or parent.ZIndex + 5
})
end

local function formatValue(value, precision, suffix)
local fmt = "%." .. tostring(precision or 0) .. "f"
return string.format(fmt, value) .. (suffix or "")
end

local function roundStep(value, step)
step = step or 1
return math.floor((value / step) + 0.5) * step
end

local function safeCallback(callback, ...)
if callback then task.spawn(callback, ...) end
end

local function MakeDraggable(dragArea, targetObject)
local dragToggle, dragInput, dragStart, dragPos
dragArea.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 then
dragToggle = true; dragStart = input.Position; dragPos = targetObject.Position
end
end)
dragArea.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 then dragToggle = false end
end)
UserInputService.InputChanged:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
end)
RunService.RenderStepped:Connect(function()
if dragToggle and dragInput then
local delta = dragInput.Position - dragStart
TweenService:Create(targetObject, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
Position = UDim2.new(dragPos.X.Scale, dragPos.X.Offset + delta.X, dragPos.Y.Scale, dragPos.Y.Offset + delta.Y)
}):Play()
end
end)
end

function SupremacyUI.new(options)
options = options or {}

local Library = {
    Flags = {},
    Windows = {},
    ActiveKeybinds = {},
    TransparencyRegistry = {},
    NotificationSettings = {
        Duration = 3,
        Transparency = options.MenuTransparency or 0.05
    },
    Theme = {
        Accent = options.Accent or rgb(179, 0, 45),
        Background = rgb(12, 12, 12), Panel = rgb(17, 17, 17), Field = rgb(41, 41, 41),
        FieldTop = rgb(75, 75, 75), FieldBottom = rgb(50, 50, 50), Border = rgb(0, 0, 0),
        BorderDark = rgb(40, 40, 40), BorderSoft = rgb(48, 48, 48), BorderLight = rgb(60, 60, 60),
        Text = rgb(205, 205, 205), Muted = rgb(152, 152, 152), White = rgb(255, 255, 255),
        MenuTransparency = options.MenuTransparency or 0.05
    },
    Parent = options.Parent or parentGui()
}

local theme = Library.Theme

local NotifGui = Instance.new("ScreenGui", Library.Parent)
NotifGui.Name = "Supremacy_Notifications"
NotifGui.IgnoreGuiInset = true

local NotifLayout = new("Frame", {
    Parent = NotifGui, Size = UDim2.new(0, 250, 1, -40), Position = UDim2.new(1, -270, 0, 20),
    BackgroundTransparency = 1
})
local notifList = addList(NotifLayout, 6)
notifList.VerticalAlignment = Enum.VerticalAlignment.Bottom
Library.NotifLayout = NotifLayout

local function registerTransparency(inst, isStroke)
    table.insert(Library.TransparencyRegistry, { Instance = inst, IsStroke = isStroke })
    if isStroke then inst.Transparency = theme.MenuTransparency
    else inst.BackgroundTransparency = theme.MenuTransparency end
end

function Library:SetMenuTransparency(value)
    theme.MenuTransparency = value
    for _, entry in ipairs(self.TransparencyRegistry) do
        if entry.Instance and entry.Instance.Parent then
            if entry.IsStroke then entry.Instance.Transparency = value else entry.Instance.BackgroundTransparency = value end
        end
    end
end


local function applySupremacyBorders(parent)
local borderColors = { rgb(60, 60, 60), rgb(40, 40, 40), rgb(40, 40, 40), rgb(40, 40, 40), rgb(60, 60, 60), rgb(31, 31, 31) }
local totalThickness = 0
for _, color in ipairs(borderColors) do
local borderFrame = new("Frame", {
Parent = parent, Size = UDim2.new(1, (totalThickness - 1) * 2 + 2, 1, (totalThickness - 1) * 2 + 2),
Position = UDim2.new(0, -(totalThickness - 1) - 1, 0, -(totalThickness - 1) - 1),
BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = parent.ZIndex + 1
})
local stroke = new("UIStroke", { Parent = borderFrame, LineJoinMode = Enum.LineJoinMode.Miter, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = color, Thickness = 1 })
registerTransparency(stroke, true)
totalThickness = totalThickness + 1
end
end

local function framed(parent, props)
    local outer = new("Frame", { Parent = parent, Position = props.Position or UDim2.new(), Size = props.Size or UDim2.new(), BackgroundColor3 = theme.Panel, BorderSizePixel = 0, ZIndex = props.ZIndex or parent.ZIndex + 1, ClipsDescendants = props.ClipsDescendants or false })
    registerTransparency(outer, false); local outerStroke = addStroke(outer, theme.Border, 1); registerTransparency(outerStroke, true)
    local inner = new("Frame", { Parent = outer, Position = UDim2.new(0, 1, 0, 1), Size = UDim2.new(1, -2, 1, -2), BackgroundColor3 = props.BackgroundColor3 or theme.Panel, BorderSizePixel = 0, ZIndex = outer.ZIndex + 1, ClipsDescendants = props.ClipsDescendants or false })
    registerTransparency(inner, false); local innerStroke = addStroke(inner, theme.BorderSoft, 1); registerTransparency(innerStroke, true)
    return outer, inner
end

local function field(parent, pos, size, z, useGradient)
    local outer = new("Frame", { Parent = parent, Position = pos, Size = size, BackgroundColor3 = theme.Border, BorderSizePixel = 0, ZIndex = z or parent.ZIndex + 2 })
    local inner = new("Frame", { Parent = outer, Position = UDim2.new(0, 1, 0, 1), Size = UDim2.new(1, -2, 1, -2), BackgroundColor3 = theme.Field, BorderSizePixel = 0, ZIndex = outer.ZIndex + 1 })
    local gradient
    if useGradient then gradient = new("UIGradient", { Parent = inner, Rotation = 90, Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, theme.FieldTop), ColorSequenceKeypoint.new(1, theme.FieldBottom) }) }) end
    return outer, inner, gradient
end

local function dropdownArrow(parent, z)
    local holder = new("Frame", { Parent = parent, Position = UDim2.new(1, -18, 0, 0), Size = UDim2.new(0, 18, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = z or parent.ZIndex + 2 })
    local pixels = {}
    for i = 1, 9 do pixels[i] = new("Frame", { Parent = holder, Size = UDim2.new(0, 1, 0, 1), BackgroundColor3 = theme.Muted, BorderSizePixel = 0, ZIndex = holder.ZIndex + 1 }) end
    local down = { { 4, 8 }, { 5, 8 }, { 6, 8 }, { 7, 8 }, { 8, 8 }, { 5, 9 }, { 6, 9 }, { 7, 9 }, { 6, 10 } }
    local up = { { 6, 8 }, { 5, 9 }, { 6, 9 }, { 7, 9 }, { 4, 10 }, { 5, 10 }, { 6, 10 }, { 7, 10 }, { 8, 10 } }
    local arrow = {}
    function arrow:Set(open) for index, point in ipairs(open and up or down) do pixels[index].Position = UDim2.new(0, point[1], 0, point[2]) end end
    arrow.Frame = holder; arrow:Set(false)
    return arrow
end

local function insideAbsolute(gui, position)
    local abs = gui.AbsolutePosition; local size = gui.AbsoluteSize
    return position.X >= abs.X and position.X <= abs.X + size.X and position.Y >= abs.Y and position.Y <= abs.Y + size.Y
end

local function flagObject(flag, object) if flag then Library.Flags[flag] = object end end


local WindowMethods, TabMethods, SectionMethods, ControlMethods = {}, {}, {}, {}

function Library:Window(params)
    params = params or {}
    local window = { Library = Library, Name = params.Name or "supremacy", Tabs = {}, ActiveTab = nil, Open = params.Visible ~= false, Key = params.Bind or Enum.KeyCode.Insert }
    local gui = new("ScreenGui", { Parent = Library.Parent, Name = (params.Name or "Supremacy") .. "_RobloxUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global })
    local size = params.Size or UDim2.new(0, 630, 0, 550)
    local root = new("Frame", { Parent = gui, AnchorPoint = params.AnchorPoint or Vector2.new(0, 0), Position = params.Position or UDim2.new(0, 50, 0, 50), Size = size, BackgroundColor3 = theme.Background, BorderSizePixel = 0, Visible = window.Open, ZIndex = 100 })

    registerTransparency(root, false); applySupremacyBorders(root)
    local outerCasing = root
    local client = new("Frame", { Parent = root, Position = UDim2.new(0, 6, 0, 6), Size = UDim2.new(1, -12, 1, -12), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = root.ZIndex + 2 })

    local tabsOuter, tabsInner = framed(client, { Position = UDim2.new(0, 14, 0, 14), Size = UDim2.new(0, 100, 1, -28), ZIndex = client.ZIndex + 1 })
    local elementsOuter, elementsInner = framed(client, { Position = UDim2.new(0, 134, 0, 14), Size = UDim2.new(1, -148, 1, -28), ZIndex = client.ZIndex + 1, ClipsDescendants = false })

    local tabList = addList(tabsInner, 0); tabList.HorizontalAlignment = Enum.HorizontalAlignment.Left; tabList.VerticalAlignment = Enum.VerticalAlignment.Top
    new("UIPadding", { Parent = tabsInner, PaddingTop = UDim.new(0, 4) })

    local content = new("Frame", { Parent = elementsInner, Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 1, -18), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = elementsInner.ZIndex + 1 })
    local popupLayer = new("Frame", { Parent = elementsInner, Position = UDim2.new(), Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = elementsInner.ZIndex + 200 })

    window.Gui = gui; window.Root = root; window.OuterCasing = outerCasing
    window.TabsInner = tabsInner; window.ElementsInner = elementsInner; window.Content = content
    window.PopupLayer = popupLayer; window.TabsOuter = tabsOuter; window.ElementsOuter = elementsOuter

    local DragArea = new("Frame", {Parent = root, Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1})
    MakeDraggable(DragArea, root)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and window.Key and input.KeyCode == window.Key then window:SetOpen(not window.Open) end
    end)

    setmetatable(window, { __index = WindowMethods })
    Library.Windows[#Library.Windows + 1] = window
    return window
end

function WindowMethods:SetOpen(value) self.Open = value; self.Root.Visible = value end
function WindowMethods:GetDefaultTab()
    if self.CompatibilityTab then return self.CompatibilityTab end
    self.CompatibilityTab = self:Tab({ Name = self.Name or "main" })
    return self.CompatibilityTab
end


function WindowMethods:Tab(params)
params = params or {}
local tab = { Window = self, Name = params.Name or params.Title or "tab", Sections = {}, IsActive = false }
local index = #self.Tabs + 1
local tabButton = new("TextButton", { Parent = self.TabsInner, Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, BorderSizePixel = 0, Text = tab.Name, TextColor3 = theme.Muted, TextXAlignment = Enum.TextXAlignment.Left, TextSize = 12, Font = Enum.Font.Code, AutoButtonColor = false, LayoutOrder = index, ZIndex = self.TabsInner.ZIndex + 2 })
new("UIPadding", { Parent = tabButton, PaddingLeft = UDim.new(0, 10) })
local page = new("Frame", { Parent = self.Content, Position = UDim2.new(), Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = self.Content.ZIndex + 1 })

    local left = new("CanvasGroup", { Parent = page, Position = UDim2.new(0, 20, 0, 18), Size = UDim2.new(0, 175, 1, -38), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = page.ZIndex + 1 })
    local right = new("CanvasGroup", { Parent = page, Position = UDim2.new(0, 255, 0, 18), Size = UDim2.new(0, 175, 1, -38), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = page.ZIndex + 1 })
    
    addList(left, 4); addList(right, 4)
    new("UIPadding", { Parent = left, PaddingRight = UDim.new(0, 4) }); new("UIPadding", { Parent = right, PaddingRight = UDim.new(0, 4) })
    tab.Button = tabButton; tab.Page = page; tab.Left = left; tab.Right = right
    tabButton.MouseButton1Click:Connect(function() self:SetTab(tab) end)
    setmetatable(tab, { __index = TabMethods })
    self.Tabs[#self.Tabs + 1] = tab
    if not self.ActiveTab then self:SetTab(tab) end
    return tab
end

function WindowMethods:SetTab(tab)
    for _, other in ipairs(self.Tabs) do
        if other == tab then continue end
        other.IsActive = false
        other.Page.Visible = false
        TweenService:Create(other.Button, TweenInfo.new(0.2), {TextColor3 = theme.Muted}):Play()
    end
    
    if not tab.IsActive then
        tab.IsActive = true
        tab.Page.Visible = true
        
        tab.Page.Position = UDim2.new(0, 0, 0, 15)
        tab.Left.GroupTransparency = 1
        tab.Right.GroupTransparency = 1
        
        TweenService:Create(tab.Page, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
        TweenService:Create(tab.Left, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()
        TweenService:Create(tab.Right, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()
    end

    TweenService:Create(tab.Button, TweenInfo.new(0.2), {TextColor3 = theme.Accent}):Play()
    self.ActiveTab = tab
end


function TabMethods:Section(params)
params = params or {}
local side = params.Side == "Right" and "Right" or "Left"
local parent = self[side]
local section = { Tab = self, Window = self.Window, Name = params.Name or "", Controls = {} }
local container = new("Frame", { Parent = parent, Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = parent.ZIndex + 1 })
local inner = new("Frame", { Parent = container, Position = UDim2.new(), Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = container.ZIndex + 1 })
local list = addList(inner, 4); bindAutoHeight(inner, list, 0)
local function update() container.Size = UDim2.new(1, 0, 0, list.AbsoluteContentSize.Y) end
list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update); task.defer(update)
section.Container = container; section.Outer = container; section.Inner = inner; section.Layout = list
setmetatable(section, { __index = SectionMethods })
self.Sections[#self.Sections + 1] = section
return section
end

local function controlBase(section, height)
    local row = new("Frame", { Parent = section.Inner, Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = section.Inner.ZIndex + 1 })
    local control = { Section = section, Window = section.Window, Row = row }
    setmetatable(control, { __index = ControlMethods })
    section.Controls[#section.Controls + 1] = control
    return control, row
end


function SectionMethods:Label(params)
params = params or {}
local control, row = controlBase(self, 11)
control.Label = text(row, params.Text or params.Name or "label", UDim2.new(0, 20, 0, 0), UDim2.new(1, -20, 1, 0), theme.Text, row.ZIndex + 1)
return control
end

function SectionMethods:Button(params)
    params = params or {}
    local control, row = controlBase(self, 20)
    local outer, inner = field(row, UDim2.new(0, 20, 0, 0), UDim2.new(1, -20, 0, 20), row.ZIndex + 1)
    text(inner, params.Name or "button", UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), theme.Text, inner.ZIndex + 1).TextXAlignment = Enum.TextXAlignment.Center
    local click = buttonOverlay(outer)
    click.MouseEnter:Connect(function() TweenService:Create(inner, TweenInfo.new(0.15), {BackgroundColor3 = theme.FieldTop}):Play() end)
    click.MouseLeave:Connect(function() TweenService:Create(inner, TweenInfo.new(0.15), {BackgroundColor3 = theme.Field}):Play() end)
    click.MouseButton1Down:Connect(function() TweenService:Create(inner, TweenInfo.new(0.1), {BackgroundColor3 = theme.Accent}):Play() end)
