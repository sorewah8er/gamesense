    local alphaHitbox = buttonOverlay(alphaBg, alphaBg.ZIndex + 5)

    local function placePopup()
        local parentAbs = popupParent.AbsolutePosition; local previewAbs = previewOuter.AbsolutePosition
        popup.Position = UDim2.new(0, previewAbs.X - parentAbs.X - 170, 0, previewAbs.Y - parentAbs.Y + 10) 
    end
    local function paint()
        previewInner.BackgroundColor3 = color; svCanvas.BackgroundColor3 = Color3.fromHSV(hue, 1, 1); alphaCanvas.BackgroundColor3 = color
        TweenService:Create(svMarker, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.new(sat, -2, 1 - val, -2) }):Play()
