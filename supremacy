    alphaHitbox.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingAlpha = true; updateAlpha(input.Position) end end)

    UserInputService.InputChanged:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseMovement then 
            if draggingSV then updateSV(input.Position) end
            if draggingHue then updateHue(input.Position) end
            if draggingAlpha then updateAlpha(input.Position) end
        end 
    end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSV = false; draggingHue = false; draggingAlpha = false end end)
    UserInputService.InputBegan:Connect(function(input)
        if popup.Visible and input.UserInputType == Enum.UserInputType.MouseButton1 and not insideAbsolute(popup, input.Position) and not insideAbsolute(previewOuter, input.Position) then popup.Visible = false end
    end)

    local picker = { 
        Set = function(newColor, newAlpha, call) color = newColor or theme.Accent; alpha = newAlpha or 1; hue, sat, val = color:ToHSV(); paint(); if call ~= false then safeCallback(params.Callback or params.Changed, color, alpha) end end, 
        Get = function() return color, alpha end 
    }
    paint(); flagObject(params.Flag, picker)
    return picker
end

